# ============================================================
# FALAH Quran API — server environment. Copy to .env (never commit .env).
# ============================================================

# --- Database (Supabase Postgres or any Postgres 16+) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only — never in Flutter, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 secret used to verify user access tokens on /api/v1/me/*
SUPABASE_JWT_SECRET=

# --- Source datasets ---
QURAN_SOURCE_URL=https://github.com/risan/quran-json
QURAN_SOURCE_API_URL=https://cdn.jsdelivr.net/npm/quran-json@3.1.2/dist/
QURAN_DATASET_VERSION=2026.09.16-1
DEFAULT_EDITION_SLUG=quran-json-uthmani-hafs

# --- PRIVATE MODE ---
# true (the default) forces every public switch off no matter what else is set,
# binds the server to loopback, and keeps religious content behind auth.
PRIVATE_MODE=true

# --- Licence flags (all false until the owner documents the rights) ---
# Each one is a claim about a specific licence and must be backed by a CONFIRMED
# record in the License Center (`npm run license:list`).
CONTENT_LICENSE_CONFIRMED=false
TRANSLATIONS_LICENSE_CONFIRMED=false
AUDIO_LICENSE_CONFIRMED=false
TAFSIR_LICENSE_CONFIRMED=false
QIRAAT_LICENSE_CONFIRMED=false
DATA_REDISTRIBUTION_ALLOWED=false
PUBLIC_DATA_ENABLED=false
PUBLIC_API_ENABLED=false

# --- API ---
API_BASE_URL=
ENVIRONMENT=staging
# Defaults to 127.0.0.1 while PRIVATE_MODE=true.
HOST=127.0.0.1
PORT=8787
API_CORS_ORIGINS=
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
DB_POOL_MAX=10
