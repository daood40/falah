{
  "name": "@falah/quran-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FALAH Quran Data Platform — import pipeline, verification and read-only REST API",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "serve": "node src/server.ts",
    "import": "node src/import/cli.ts",
    "import:audio": "node src/import/audio-cli.ts",
    "verify": "node src/import/verify-cli.ts",
    "db:apply": "node scripts/apply-migrations.ts",
    "openapi:validate": "node scripts/validate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "integrity": "node scripts/integrity-report.ts",
    "integrity:final": "node scripts/final-integrity-report.ts",
    "verify:human": "node src/import/human-verification-cli.ts",
    "license:record": "node src/import/license-cli.ts",
    "license:list": "node src/import/license-cli.ts --list",
    "release:gate": "node scripts/public-release-gate.ts",
    "verify:cross": "node scripts/cross-verify.ts",
    "discover:sources": "node scripts/source-discovery.ts",
    "scheme:list": "node src/import/scheme-cli.ts --list",
    "scheme:decide": "node src/import/scheme-cli.ts",
    "bootstrap:check": "node scripts/clean-bootstrap.ts",
    "gate:tests": "node tests/gate/run.ts",
    "gate:core": "node tests/gate/run.ts --skip=flutter,web,mobile,docker-deploy --label=core",
    "gate:merge": "node tests/gate/merge.ts",
    "device:expectations": "node scripts/device-expectations.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "quran-json": "3.1.2",
    "quran-meta": "6.0.17"
  },
  "devDependencies": {
    "@ghoran/text": "^0.0.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "quran-db": "^1.2.4",
    "quran-qcf4": "^1.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
