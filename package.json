{
  "name": "falah",
  "private": true,
  "version": "1.2.0",
  "description": "FALAH — منصة احترافية لصناعة وتنظيم ونشر المحتوى الإسلامي الموثوق",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "db:validate": "bash scripts/validate-db.sh"
  },
  "dependencies": {
    "@kazishariar/nawawi-40-hadith-data": "^1.0.3",
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.8",
    "quran-json": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
