# ============================================================
# FALAH Hadith API — copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Runtime ---
ENVIRONMENT=staging          # staging | production | test
PORT=8787
API_BASE_URL=http://127.0.0.1:8787

# --- Content rights gates (two, independent) ---
# While false, the public API returns raw_text/matn/isnad/takhrij as null.
# Flip to true ONLY after the rights for the edition are confirmed in writing.
# No code change or redeploy of the schema is needed.
CONTENT_LICENSE_CONFIRMED=false
# Do the rights EXIST (above) vs has the operator DECIDED to publish (below).
# Exports and bulk data obey this second gate, so confirming a licence never
# publishes data by itself.
PUBLIC_DATA_ENABLED=false

# --- Database ---
# Supabase: Project Settings → Database → Connection string (session pooler).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/falah

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-SIDE ONLY. Never in Flutter, never in a web client, never in git.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings → JWT Secret (admin JWT verification).
SUPABASE_JWT_SECRET=

# --- Admin (server-to-server, e.g. the CI importer) ---
# Long random string. Rotate on leak. Never ships to a client.
ADMIN_API_KEY=

# --- Limits ---
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CORS_ORIGINS=*

# --- Dataset ---
ACTIVE_DATASET_VERSION=JAMI-KAMIL-1437-V1
