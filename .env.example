# ============================================================
# FALAH — Environment Configuration
# Copy to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================

# --- Supabase (Backend: Auth, Database, Storage) ---
# Create a project at https://supabase.com, then copy from Project Settings → API.
# The anon key is safe for the client (RLS protects data). NEVER put the
# service_role key here or anywhere in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Hadith API (sunnah.com) ---
# Request a key at https://sunnah.api-docs.io (required for live hadith fetching).
# Without it, FALAH uses the bundled verified hadith dataset only.
VITE_SUNNAH_API_KEY=

# --- Quran API ---
# api.alquran.cloud is free and requires no key. Override only for self-hosting.
VITE_QURAN_API_BASE=https://api.alquran.cloud/v1

# ============================================================
# Server-side secrets (Supabase Edge Functions — set via
# `supabase secrets set`, NEVER in this file's VITE_ vars)
# ============================================================
# ANTHROPIC_API_KEY=        → for the ai-assistant edge function
# META_APP_ID= / META_APP_SECRET=       → Instagram/Facebook publishing (OAuth)
# TIKTOK_CLIENT_KEY= / TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID= / YOUTUBE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# X_API_KEY= / X_API_SECRET=
